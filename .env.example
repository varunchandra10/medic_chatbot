# ==========================================
# Medi-Assist AI Environment Configuration
# Copy this file to .env and fill in your values
# ==========================================

# Embedding Model Provider: "google" (recommended, hosted text-embedding-004) or "huggingface" (local)
EMBEDDING_PROVIDER="google"

# Vector Database (Pinecone)
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX_NAME="medical-chatbot-pdf-wiki"

# LLM Reasoning & Embeddings Engine (Google Gemini)
GOOGLE_API_KEY="your_gemini_api_key_here"

# Medical News API (NewsData.io)
NEWS_DATA_API_KEY="your_newsdata_api_key_here"

# PubMed / NCBI (Optional for enhanced biomedical literature retrieval)
NCBI_EMAIL="your_email@example.com"
NCBI_API_KEY="your_ncbi_api_key_here"

# Database (MongoDB Atlas or Local MongoDB)
MONGO_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0"

# Flask Session Security (Generate a secure 32-byte key via python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY="generate_a_secure_random_hex_key_here"

# Server Port
PORT="8080"
OLLAMA_MODEL=llama3.2:1b
USE_CLOUD_LLM=false

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
